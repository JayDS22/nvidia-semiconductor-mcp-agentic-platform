# LLM backend — pick one (Nemotron preferred for NVIDIA-native signal).
# Get a free NVIDIA NIM key at https://build.nvidia.com/
NVIDIA_API_KEY=

# Fallback: Anthropic Claude (used during dev if NVIDIA key not set).
ANTHROPIC_API_KEY=

# Model selection (defaults sensible).
LLM_BACKEND=nvidia            # nvidia | anthropic | mock

# NVIDIA NIM model — pick one that's currently live at integrate.api.nvidia.com
# Verified working (as of Sep 2026):
#   meta/llama-3.3-70b-instruct           (default, tool-use capable, free tier)
#   nvidia/llama-3.1-nemotron-70b-instruct (NVIDIA-tuned, tool-use capable)
#   mistralai/mixtral-8x7b-instruct-v0.1  (fast, tool-use capable)
# Deprecated (returns 404):
#   nvidia/nemotron-4-340b-instruct       (removed from NIM catalog)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

ANTHROPIC_MODEL=claude-sonnet-4-6
